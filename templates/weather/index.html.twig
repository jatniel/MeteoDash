{% extends 'base.html.twig' %}

{% block body %}
    <section class="hero" id="hero" aria-labelledby="hero-title">
        <h2 class="hero-title" id="hero-title">Quel temps fait-il à…</h2>

        <div class="hero-slot" id="home-slot">
            <div class="finder" id="finder">
                <form class="search" id="search-form" role="search" method="post" action="{{ path('app_weather') }}" novalidate>
                    <label class="sr-only" for="city-input">Ville</label>
                    <div class="field">
                        <input class="field-input" type="search" id="city-input" placeholder="Nom d’une ville" autocomplete="off" autocapitalize="words" spellcheck="false" maxlength="100" aria-describedby="search-hint">
                        <button class="field-btn" type="submit" id="search-btn">
                            <svg class="field-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
                            <span class="field-btn-label">Rechercher</span>
                        </button>
                    </div>
                </form>
                <p class="message" id="loading" hidden>
                    <span class="pulse" aria-hidden="true"></span>
                    <span>Recherche de la météo…</span>
                </p>
                <p class="message is-error" id="error" role="alert"></p>
            </div>
        </div>

        <ul class="pills" id="picks">
            <li><button class="pill" type="button" data-city="Paris">Paris</button></li>
            <li><button class="pill" type="button" data-city="Lyon">Lyon</button></li>
            <li><button class="pill" type="button" data-city="Marseille">Marseille</button></li>
            <li><button class="pill" type="button" data-city="Bruxelles">Bruxelles</button></li>
            <li><button class="pill" type="button" data-city="Montréal">Montréal</button></li>
            <li><button class="pill" type="button" data-city="Genève">Genève</button></li>
        </ul>

        <p class="hero-hint" id="search-hint">Saisissez le nom d’une ville, ou choisissez-en une.</p>
    </section>

    <noscript><p class="hero-hint">Activez JavaScript pour rechercher une ville.</p></noscript>

    <p class="sr-only" id="status" role="status" aria-live="polite"></p>

    <section class="results" id="results" aria-labelledby="place" hidden>
        <h2 class="place" id="place" tabindex="-1">
            <span class="place-city" id="place-city"></span>
            <span class="place-country" id="place-country"></span>
        </h2>

        <div class="now">
            <p class="temp" id="temp"><span class="temp-value" id="temp-value"></span><span class="temp-deg">°</span></p>
            <div class="cond">
                <p class="cond-main" id="cond"></p>
                <p class="cond-feels">Ressenti <span id="r-feels"></span></p>
            </div>
        </div>

        <section class="curve" aria-labelledby="curve-title">
            <h3 class="sr-only" id="curve-title">Températures des 15 prochaines heures</h3>
            <div class="curve-plot" id="curve"></div>
            <table class="sr-only" aria-labelledby="curve-title">
                <thead>
                    <tr>
                        <th scope="col">Heure</th>
                        <th scope="col">Température</th>
                        <th scope="col">Ciel</th>
                    </tr>
                </thead>
                <tbody id="curve-table"></tbody>
            </table>
        </section>

        <dl class="readings">
            <div class="reading"><dt>Humidité</dt><dd id="r-humidity"></dd></div>
            <div class="reading"><dt>Vent</dt><dd id="r-wind"></dd></div>
            <div class="reading"><dt>Pression</dt><dd id="r-pressure"></dd></div>
            <div class="reading"><dt>Visibilité</dt><dd id="r-visibility"></dd></div>
        </dl>
    </section>
{% endblock %}
